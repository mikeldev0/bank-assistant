{
  "$schema": "./frontend/node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.venv/**",
    "**/next-env.d.ts",
    "**/package-lock.json",
    "**/uv.lock",
    "**/playwright-report/**",
    "**/test-results/**",
    "private/**"
  ]
}
